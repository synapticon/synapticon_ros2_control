    <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=2;fontColor=#666666;" value="Drive fault reaction (this package) and robot fault handling (consumer). The policy decides, the hardware layer executes, only the consumer decides where the robot goes." vertex="1">
      <mxGeometry height="24" width="1140" x="60" y="60" as="geometry" />
    </mxCell>
    <mxCell id="controller" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F8;strokeColor=#7A93AD;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#333333;" value="&lt;b&gt;DriveController&lt;/b&gt;&amp;nbsp;&amp;nbsp;the drive fault reaction" vertex="1">
