    <mxCell id="motion" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F8;strokeColor=#7A93AD;fontSize=12;fontColor=#333333;" value="&lt;b&gt;Motion controller&lt;/b&gt;&lt;br&gt;MotorCommandController, a trajectory&lt;br&gt;controller, or any other&lt;br&gt;&lt;i&gt;forwards the consumer's setpoints,&lt;br&gt;knows nothing about faults&lt;/i&gt;" vertex="1">
