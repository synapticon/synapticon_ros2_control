    </mxCell>
    <mxCell id="c_txt" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#333333;" value="the raw drive state the controller reads (statusword, error code, link),&lt;br&gt;decoded into a condition: &lt;b&gt;healthy&lt;/b&gt;, &lt;b&gt;faulted&lt;/b&gt; or &lt;b&gt;unreachable&lt;/b&gt;.&lt;br&gt;An unreachable drive can only be observed, not commanded." vertex="1">
      <mxGeometry height="50" width="345" x="283" y="868" as="geometry" />
    </mxCell>
    <mxCell id="v_chip" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#7A5C96;" value="&lt;b&gt;request, event&lt;/b&gt;&lt;br&gt;&lt;i&gt;from the consumer&lt;/i&gt;" vertex="1">
      <mxGeometry height="50" width="150" x="120" y="1048" as="geometry" />
    </mxCell>
    <mxCell id="v_txt" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#333333;" value="a drive action request (reset, enable) or a named event (clear, estop).&lt;br&gt;Advisory input, not a command: the policy may refuse it,&lt;br&gt;e.g. no clearing while a joint is still faulted." vertex="1">
      <mxGeometry height="50" width="345" x="283" y="1048" as="geometry" />
    </mxCell>
    <mxCell id="a_chip" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#B07000;" value="&lt;b&gt;action&lt;/b&gt;&lt;br&gt;&lt;i&gt;per joint, output&lt;/i&gt;" vertex="1">
