    <mxCell id="c_chip" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#0B7A75;" value="&lt;b&gt;drive state, condition&lt;/b&gt;&lt;br&gt;&lt;i&gt;per joint, input&lt;/i&gt;" vertex="1">
