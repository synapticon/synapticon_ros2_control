    </mxCell>
    <mxCell id="a_txt" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#333333;" value="&lt;b&gt;DriveAction&lt;/b&gt;, a small enum:&lt;br&gt;enable, quick_stop, disable, reset_fault, ...&lt;br&gt;It names a &lt;b&gt;target state&lt;/b&gt;, not a controlword." vertex="1">
      <mxGeometry height="50" width="345" x="283" y="808" as="geometry" />
    </mxCell>
