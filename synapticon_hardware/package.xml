<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>synapticon_hardware</name>
  <version>0.3.0</version>
  <description>
    SynapticonSystemInterface, the ros2_control hardware interface for Synapticon SOMANET drives, and the HAL
    interface SynapticonHalI with what its HALs share: the CiA 402 handling, the EtherCAT helpers, the slave_config
    generator and the two mock HALs.
  </description>
  <maintainer email="jennifer.buehler@b-robotized.com">Jennifer Buehler</maintainer>
  <maintainer email="timotej.gaspar@b-robotized.com">Timotej Gaspar</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/synapticon/synapticon_ros2_control</url>
  <url type="bugtracker">https://github.com/synapticon/synapticon_ros2_control/issues</url>
  <author>Synapticon GmbH</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>soem_source</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_cmake_gmock</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>synapticon_control_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rosdoc2>rosdoc2.yaml</rosdoc2>
  </export>
</package>
