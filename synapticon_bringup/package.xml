<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>synapticon_bringup</name>
  <version>0.3.0</version>
  <description>
    The example launch for Synapticon drives, with robot definitions and controller configurations for
    1, 2 and 28 joints and for one joint behind a gearbox, the generator for other joint counts and the runner of
    the hardware tests.
  </description>
  <maintainer email="jennifer.buehler@b-robotized.com">Jennifer Buehler</maintainer>
  <maintainer email="timotej.gaspar@b-robotized.com">Timotej Gaspar</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/synapticon/synapticon_ros2_control</url>
  <url type="bugtracker">https://github.com/synapticon/synapticon_ros2_control/issues</url>
  <author>Synapticon GmbH</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Reading and writing robot definitions. -->
  <exec_depend>python3-yaml</exec_depend>

  <exec_depend>synapticon_description</exec_depend>
  <exec_depend>synapticon_ethercat_soem</exec_depend>
  <exec_depend>synapticon_hardware</exec_depend>

  <!-- The example launch and its controllers. -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- RViz, when the launch shows the robot. -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <exec_depend>synapticon_control_msgs</exec_depend>
  <!-- The controllers of this repository and their messages. -->
  <exec_depend>synapticon_controllers</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>controller_manager_msgs</test_depend>
  <test_depend>diagnostic_msgs</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>std_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
