<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>synapticon_ethercat_soem</name>
  <version>0.3.0</version>
  <description>
    EtherCAT HAL for Synapticon SOMANET drives through the SOEM master library, in user space and without a kernel
    module: the HAL plugin, its unit tests and its hardware tests.
  </description>
  <maintainer email="jennifer.buehler@b-robotized.com">Jennifer Buehler</maintainer>
  <maintainer email="timotej.gaspar@b-robotized.com">Timotej Gaspar</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/synapticon/synapticon_ros2_control</url>
  <url type="bugtracker">https://github.com/synapticon/synapticon_ros2_control/issues</url>
  <author>Synapticon GmbH</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>soem_source</depend>
  <depend>synapticon_hardware</depend>
  <depend>yaml-cpp</depend>

  <!-- capsh, for the script that grants the raw socket capability. -->
  <exec_depend>libcap2-bin</exec_depend>

  <test_depend>ament_cmake_gmock</test_depend>
  <test_depend>ament_index_cpp</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
